<!-- React Logic (100% Local Storage) -->
<script type="text/babel">
const { useState, useEffect } = React;
const NEON_COLORS = [
{ name: 'Verde', hex: '#39FF14' }, { name: 'Amarillo', hex: '#CCFF00' },
{ name: 'Cian', hex: '#00F0FF' }, { name: 'Rosa', hex: '#FF007F' }
];
// Se conservan los emojis solo como avatares de equipo
const AVATARS = ['🥒', '🥑', '⚡', '🔥', '🐯', '👑', '🏓', '⭐', '😎', '🦖'];
// ==========================================
// ADAPTADOR DE BASE DE DATOS LOCAL
// ==========================================
const DBAdapter = {
listeners: {},
triggerUpdate(id, data) {
if (this.listeners[id]) this.listenersid;
},
save(id, data) {
localStorage.setItem(⁠pkl_${id}⁠, JSON.stringify(data));
this.triggerUpdate(id, data);
},
update(id, data) {
const current = JSON.parse(localStorage.getItem(⁠pkl_${id}⁠) || '{}');
const merged = { ...current, ...data };
localStorage.setItem(⁠pkl_${id}⁠, JSON.stringify(merged));
this.triggerUpdate(id, merged);
},
subscribe(id, callback, errorCallback) {
const trigger = () => {
const data = localStorage.getItem(⁠pkl_${id}⁠);
if (data) callback(JSON.parse(data));
else errorCallback();
};
this.listeners[id] = trigger;
trigger();
// Permite sincronizar si abres dos pestañas en el mismo navegador
const storageListener = (e) => {
if (e.key === ⁠pkl_${id}⁠) {
if (e.newValue) callback(JSON.parse(e.newValue));
else errorCallback();
}
};
window.addEventListener('storage', storageListener);
return () => {
delete this.listeners[id];
window.removeEventListener('storage', storageListener);
};
}
};
function App() {
const [tournamentId, setTournamentId] = useState('');
const [tournamentData, setTournamentData] = useState(null);
const [activeTab, setActiveTab] = useState('bracket');
const [localIsAdmin, setLocalIsAdmin] = useState(false);
const [banner, setBanner] = useState('');
// Formulario
const [setupName, setSetupName] = useState('Torneo');
const [setupPoints, setSetupPoints] = useState(11);
const [setupPin, setSetupPin] = useState('1234');
const [setupTeams, setSetupTeams] = useState([
{ id: 't1', name: 'Equipo 1', color: '#39FF14', avatarType: 'preset', avatarValue: '🥒' },
{ id: 't2', name: 'Equipo 2', color: '#CCFF00', avatarType: 'preset', avatarValue: '⚡' },
{ id: 't3', name: 'Equipo 3', color: '#00F0FF', avatarType: 'preset', avatarValue: '🐯' },
{ id: 't4', name: 'Equipo 4', color: '#FF007F', avatarType: 'preset', avatarValue: '👑' }
]);
const [newTeamName, setNewTeamName] = useState('');
const [newTeamPhotoUrl, setNewTeamPhotoUrl] = useState('');
const [joinCodeInput, setJoinCodeInput] = useState('');
const [pinPromptOpen, setPinPromptOpen] = useState(false);
const [enteredPin, setEnteredPin] = useState('');
useEffect(() => {
try {
const params = new URLSearchParams(window.location.search);
const code = params.get('t');
if (code) setTournamentId(code.toUpperCase());
} catch(e) {}
}, []);
useEffect(() => {
if (!tournamentId) return;
const unsub = DBAdapter.subscribe(tournamentId,
(data) => {
setTournamentData(data);
// En modo local, siempre asumimos que si entras puedes usar el PIN para ser admin
// o si lo acabas de crear, ya eres admin.
},
() => {
triggerBanner("Torneo no encontrado");
setTournamentId(''); setTournamentData(null);
}
);
return () => unsub();
}, [tournamentId]);
const triggerBanner = (msg) => { setBanner(msg); setTimeout(() => setBanner(''), 3000); };
const handleAddTeam = (e) => {
e.preventDefault();
if(!newTeamName.trim()) return;
let aType = 'preset', aVal = AVATARS[Math.floor(Math.random() * AVATARS.length)];
if (newTeamPhotoUrl.trim() !== '') { aType = 'url'; aVal = newTeamPhotoUrl.trim(); }
setSetupTeams([...setupTeams, {
id: 't-' + Date.now(), name: newTeamName.trim(),
color: NEON_COLORS[Math.floor(Math.random() * NEON_COLORS.length)].hex,
avatarType: aType, avatarValue: aVal
}]);
setNewTeamName(''); setNewTeamPhotoUrl('');
};
const generateBracket = (teams) => {
let list = [...teams.map(t => t.id)];
const power = Math.max(1, Math.ceil(Math.log2(list.length)));
const targetSize = Math.pow(2, power);
while(list.length < targetSize) list.push('BYE');
let matches = [];
let roundNodes = [];
let mId = 1;
for (let i = 0; i < targetSize; i += 2) {
let tA = list[i];
let tB = list[i+1];
let isBye = tA === 'BYE' || tB === 'BYE';
let winner = null;
if (isBye) winner = tA === 'BYE' ? tB : tA;
let match = {
id: ⁠M${mId++}⁠,
round: 1,
teamAId: tA, teamBId: tB,
scoreA: 0, scoreB: 0,
status: isBye ? 'completed' : 'scheduled',
winnerId: winner,
nextMatchId: null, nextSlot: null
};
matches.push(match);
roundNodes.push(match);
}
let currentRound = 2;
while (roundNodes.length > 1) {
let nextRoundNodes = [];
for (let i = 0; i < roundNodes.length; i += 2) {
let m1 = roundNodes[i];
let m2 = roundNodes[i+1];
let tA = m1.winnerId || null;
let tB = m2.winnerId || null;
let isBye = tA === 'BYE' || tB === 'BYE';
let winner = null;
if (isBye) winner = tA === 'BYE' ? tB : tA;
let newMatch = {
id: ⁠M${mId++}⁠,
round: currentRound,
teamAId: tA, teamBId: tB,
scoreA: 0, scoreB: 0,
status: (tA && tB && tA !== 'BYE' && tB !== 'BYE') ? 'scheduled' : (isBye ? 'completed' : 'pending'),
winnerId: winner,
nextMatchId: null, nextSlot: null
};
m1.nextMatchId = newMatch.id; m1.nextSlot = 'A';
m2.nextMatchId = newMatch.id; m2.nextSlot = 'B';
matches.push(newMatch);
nextRoundNodes.push(newMatch);
}
roundNodes = nextRoundNodes;
currentRound++;
}
return { matches, totalRounds: power };
};
const handleCreateTournament = () => {
if (setupTeams.length < 2) return triggerBanner("Registra al menos 2 equipos");
if (setupPoints < 5 || setupPoints > 21) return triggerBanner("Puntos deben ser entre 5 y 21");
const code = Math.random().toString(36).substring(2, 8).toUpperCase();
const { matches, totalRounds } = generateBracket(setupTeams);
DBAdapter.save(code, {
id: code, name: setupName, pointsToWin: setupPoints, totalRounds,
teams: setupTeams, matches, adminPin: setupPin
});
setTournamentId(code);
setLocalIsAdmin(true);
setActiveTab('bracket');
try {
const cleanUrl = ⁠${window.location.origin}${window.location.pathname}?t=${code}⁠;
window.history.replaceState({}, '', cleanUrl);
} catch(e) {}
};
const handleVerifyPin = (e) => {
e.preventDefault();
if (enteredPin === tournamentData?.adminPin) {
setLocalIsAdmin(true); setPinPromptOpen(false); setEnteredPin('');
triggerBanner("Permisos habilitados");
} else triggerBanner("PIN Incorrecto");
};
const updateScore = (mId, team, isIncrement) => {
if (!localIsAdmin || !tournamentData) return;
const matches = tournamentData.matches.map(m => {
if (m.id !== mId) return m;
let sA = team === 'A' ? Math.max(0, m.scoreA + (isIncrement ? 1 : -1)) : m.scoreA;
let sB = team === 'B' ? Math.max(0, m.scoreB + (isIncrement ? 1 : -1)) : m.scoreB;
return { ...m, scoreA: sA, scoreB: sB, status: (sA > 0 || sB > 0) && m.status === 'scheduled' ? 'live' : m.status };
});
DBAdapter.update(tournamentId, { matches });
};
const finishMatch = (mId) => {
if (!localIsAdmin || !tournamentData) return;
const match = tournamentData.matches.find(m => m.id === mId);
if (match.scoreA === match.scoreB) return triggerBanner("Debe haber un ganador");
const winnerId = match.scoreA > match.scoreB ? match.teamAId : match.teamBId;
let newMatches = [...tournamentData.matches];
let mIndex = newMatches.findIndex(m => m.id === mId);
newMatches[mIndex] = { ...match, status: 'completed', winnerId };
if (match.nextMatchId) {
let nIndex = newMatches.findIndex(m => m.id === match.nextMatchId);
if (nIndex > -1) {
let nm = { ...newMatches[nIndex] };
if (match.nextSlot === 'A') nm.teamAId = winnerId;
if (match.nextSlot === 'B') nm.teamBId = winnerId;
if (nm.teamAId && nm.teamBId && nm.teamAId !== 'BYE' && nm.teamBId !== 'BYE') {
nm.status = 'scheduled';
}
newMatches[nIndex] = nm;
}
}
DBAdapter.update(tournamentId, { matches: newMatches });
};
const removeTeam = (tId) => {
if (!localIsAdmin || !tournamentData) return;
const confirmDelete = window.confirm("¿Eliminar equipo de forma permanente?");
if(confirmDelete){
const teams = tournamentData.teams.filter(t => t.id !== tId);
DBAdapter.update(tournamentId, { teams });
}
};
const getTeam = (id) => {
if (id === 'BYE') return { name: 'Libre', avatarValue: '🏃', color: '#555' };
return tournamentData?.teams.find(t => t.id === id) || { name: 'Por definir', avatarValue: '⏳', color: '#333' };
};
const renderAvatar = (team, sizeClass = "w-10 h-10 text-xl") => {
const style = { borderColor: team.color || '#333' };
if (team.avatarType === 'url' && team.avatarValue) {
return (
<div className={⁠${sizeClass} rounded-full border-2 overflow-hidden bg-gray-800 flex-shrink-0 relative group⁠} style={style}>
<img src={team.avatarValue} alt={team.name} className="w-full h-full object-cover" onError={(e) => { e.target.style.display = 'none'; e.target.nextSibling.style.display = 'flex'; }} />
<div className="avatar-fallback absolute inset-0 bg-gray-800 items-center justify-center font-bold text-white text-xs">{team.name.charAt(0)}</div>
</div>
);
}
return <div className={⁠${sizeClass} rounded-full border-2 bg-[#12192A] flex items-center justify-center font-bold flex-shrink-0 select-none⁠} style={style}>{team.avatarValue}</div>;
};
return (
<div className="flex flex-col min-h-screen font-sans pb-10">
{banner && <div className="fixed top-4 left-1/2 -translate-x-1/2 z-50 bg-white text-black px-4 py-2 rounded-lg font-bold text-xs shadow-lg whitespace-nowrap">{banner}</div>}
{pinPromptOpen && (
<div className="fixed inset-0 bg-black/90 z-50 flex items-center justify-center p-4">
<div className="bg-pickleCard p-6 rounded-xl w-full max-w-xs text-center border border-gray-800">
<h3 className="text-white font-bold mb-4">Ingresar PIN</h3>
<form onSubmit={handleVerifyPin} className="space-y-3">
<input type="password" required maxLength="4" value={enteredPin} onChange={e=>setEnteredPin(e.target.value)} className="w-full bg-[#12192A] text-center text-xl text-pickleGreen font-bold p-3 rounded-lg focus:outline-none" />
<div className="flex gap-2">
<button type="button" onClick={() => setPinPromptOpen(false)} className="flex-1 bg-gray-800 text-white rounded-lg py-2 text-xs font-bold">Cancelar</button>
<button type="submit" className="flex-1 bg-pickleGreen text-black rounded-lg py-2 text-xs font-bold">Entrar</button>
</div>
</form>
</div>
</div>
)}
<header className="p-4 border-b border-gray-900 flex justify-between items-center bg-[#070A14] sticky top-0 z-40">
<div className="flex items-center gap-3">
<h1 className="font-black text-white text-lg">REAL<span className="text-pickleGreen">PICKLEBALL</span></h1>
<span className="px-2 py-0.5 bg-gray-800 text-gray-400 rounded text-[9px] font-bold uppercase border border-gray-700">Modo Local</span>
</div>
{tournamentId && (
<div className="flex items-center gap-2">
{localIsAdmin ? (
<span className="px-2 py-1 bg-gray-800 text-gray-300 rounded text-[10px] font-bold uppercase border border-gray-700">Admin</span>
) : (
<button onClick={() => setPinPromptOpen(true)} className="px-2 py-1 bg-gray-800 text-white rounded text-[10px] font-bold uppercase border border-gray-700 transition-colors hover:bg-gray-700">Editar</button>
)}
<button onClick={() => { setTournamentId(''); setTournamentData(null); setLocalIsAdmin(false); }} className="px-2 py-1 bg-gray-900 text-gray-400 rounded text-[10px] font-bold uppercase hover:text-white transition-colors">Salir</button>
</div>
)}
</header>
<main className="max-w-6xl mx-auto w-full p-4">
{!tournamentId ? (
<div className="grid md:grid-cols-2 gap-6 max-w-4xl mx-auto">
{/* Entrar a Torneo Existente (Local) */}
<div className="bg-pickleCard p-6 rounded-2xl border border-gray-800">
<h2 className="text-white font-bold mb-4">Cargar Torneo Local</h2>
<form onSubmit={(e) => { e.preventDefault(); if(joinCodeInput) setTournamentId(joinCodeInput.toUpperCase()); }} className="flex gap-2">
<input type="text" placeholder="ID DEL TORNEO" value={joinCodeInput} onChange={e=>setJoinCodeInput(e.target.value)} className="flex-1 bg-[#12192A] text-white font-bold text-center rounded-lg p-3 focus:outline-none uppercase" />
<button type="submit" className="bg-gray-200 text-black font-bold px-4 rounded-lg text-xs uppercase">Cargar</button>
</form>
</div>
{/* Crear Nuevo Torneo */}
<div className="bg-pickleCard p-6 rounded-2xl border border-gray-800 space-y-4">
<h2 className="text-white font-bold">Nuevo Torneo</h2>
<input type="text" value={setupName} onChange={e=>setSetupName(e.target.value)} placeholder="Nombre" className="w-full bg-[#12192A] text-white font-semibold rounded-lg p-3 focus:outline-none text-sm" />
<div className="grid grid-cols-2 gap-3">
<div>
<label className="text-[10px] font-semibold text-gray-400 uppercase block mb-1">Meta de Puntos</label>
<input type="number" min="5" max="21" value={setupPoints} onChange={e=>setSetupPoints(Number(e.target.value))} className="w-full bg-[#12192A] text-white font-bold text-center rounded-lg p-2 focus:outline-none text-sm" />
</div>
<div>
<label className="text-[10px] font-semibold text-gray-400 uppercase block mb-1">PIN Admin</label>
<input type="password" maxLength="4" value={setupPin} onChange={e=>setSetupPin(e.target.value)} placeholder="1234" className="w-full bg-[#12192A] text-white font-bold text-center rounded-lg p-2 focus:outline-none text-sm tracking-widest" />
</div>
</div>
<div className="pt-4 border-t border-gray-800">
<form onSubmit={handleAddTeam} className="flex flex-col gap-2 mb-3">
<input type="text" value={newTeamName} onChange={e=>setNewTeamName(e.target.value)} placeholder="Nombre del equipo" className="w-full bg-[#12192A] text-white text-xs font-semibold rounded-lg p-3 focus:outline-none" />
<div className="flex gap-2">
<input type="url" value={newTeamPhotoUrl} onChange={e=>setNewTeamPhotoUrl(e.target.value)} placeholder="URL Foto (Opcional)" className="flex-1 bg-[#12192A] text-white text-xs rounded-lg p-2 focus:outline-none" />
<button type="submit" className="bg-gray-700 text-white font-bold px-4 rounded-lg text-xs">Añadir</button>
</div>
</form>
<div className="flex flex-col gap-1 max-h-32 overflow-y-auto pr-1">
{setupTeams.map(t => (
<div key={t.id} className="bg-[#12192A] rounded p-2 flex items-center justify-between text-xs text-white">
<div className="flex items-center gap-2">
{renderAvatar(t, "w-5 h-5 text-[10px]")}
<span>{t.name}</span>
</div>
<button type="button" onClick={() => setSetupTeams(setupTeams.filter(x => x.id !== t.id))} className="text-gray-500 hover:text-red-400 font-bold px-2">X</button>
</div>
))}
</div>
</div>
<button onClick={handleCreateTournament} className="w-full bg-pickleYellow text-black font-bold py-3 rounded-lg text-xs uppercase mt-2">
Empezar
</button>
</div>
</div>
) : (
<div className="space-y-4">
<div className="bg-pickleCard border border-gray-800 p-4 rounded-xl flex justify-between items-center relative overflow-hidden">
<div>
<h2 className="text-white font-bold text-lg leading-tight">{tournamentData?.name}</h2>
<span className="text-gray-400 font-semibold text-xs">ID: {tournamentId}</span>
</div>
<div className="text-right">
{localIsAdmin ? (
<div className="flex items-center gap-2">
<span className="text-gray-400 text-[10px] font-bold">META (PTS):</span>
<input type="number" min="5" max="21" value={tournamentData?.pointsToWin} onChange={e => DBAdapter.update(tournamentId, { pointsToWin: Number(e.target.value)})} className="bg-gray-800 text-white font-bold rounded p-1 w-12 text-center focus:outline-none text-xs" />
</div>
) : (
<span className="text-white font-bold text-xs block">META: {tournamentData?.pointsToWin}</span>
)}
{!localIsAdmin && <span className="text-[10px] text-gray-500 uppercase font-semibold">Solo Lectura</span>}
</div>
</div>
<div className="flex gap-2 bg-[#090D18] p-1 rounded-lg">
<button onClick={()=>setActiveTab('bracket')} className={⁠flex-1 py-2 rounded text-[10px] font-bold uppercase tracking-wide ${activeTab==='bracket'?'bg-gray-800 text-white':'text-gray-500'}⁠}>Cuadro</button>
<button onClick={()=>setActiveTab('matches')} className={⁠flex-1 py-2 rounded text-[10px] font-bold uppercase tracking-wide ${activeTab==='matches'?'bg-gray-800 text-white':'text-gray-500'}⁠}>Partidos</button>
<button onClick={()=>setActiveTab('teams')} className={⁠flex-1 py-2 rounded text-[10px] font-bold uppercase tracking-wide ${activeTab==='teams'?'bg-gray-800 text-white':'text-gray-500'}⁠}>Equipos</button>
</div>
{/* ==========================================
Pestaña: Cuadro
========================================== */}
{activeTab === 'bracket' && tournamentData && (
<div className="bg-pickleCard border border-gray-800 rounded-2xl p-4 overflow-x-auto">
<div className="flex gap-6 items-stretch min-h-[350px]">
{Array.from({length: tournamentData.totalRounds}, (_, i) => i + 1).map(roundNum => {
const roundMatches = tournamentData.matches.filter(m => m.round === roundNum);
return (
<div key={roundNum} className="flex flex-col justify-around gap-4 w-56 flex-shrink-0 relative">
<div className="absolute -top-4 left-0 text-[10px] font-bold text-gray-500 uppercase">
{roundNum === tournamentData.totalRounds ? 'FINAL' : roundNum === tournamentData.totalRounds - 1 ? 'SEMIFINAL' : ⁠RONDA ${roundNum}⁠}
</div>
{roundMatches.map(m => {
const tA = getTeam(m.teamAId);
const tB = getTeam(m.teamBId);
const isLive = m.status === 'live';
const isDone = m.status === 'completed';
return (
<div key={m.id} className={⁠bg-[#0A0E1A] border rounded-lg p-3 flex flex-col justify-center relative ${isLive ? 'border-pickleGreen' : isDone ? 'border-gray-700' : 'border-dashed border-gray-800 opacity-60'}⁠}>
<div className="flex justify-between items-center mb-2 pb-2 border-b border-gray-800">
<div className="flex items-center gap-2 overflow-hidden">
{renderAvatar(tA, "w-5 h-5 text-[10px]")}
<span className={⁠text-[10px] font-semibold truncate ${m.winnerId === tA.id ? 'text-white' : 'text-gray-400'}⁠}>{tA.name}</span>
</div>
<span className="font-mono font-bold text-white text-xs pl-2">{m.scoreA}</span>
</div>
<div className="flex justify-between items-center">
<div className="flex items-center gap-2 overflow-hidden">
{renderAvatar(tB, "w-5 h-5 text-[10px]")}
<span className={⁠text-[10px] font-semibold truncate ${m.winnerId === tB.id ? 'text-white' : 'text-gray-400'}⁠}>{tB.name}</span>
</div>
<span className="font-mono font-bold text-white text-xs pl-2">{m.scoreB}</span>
</div>
</div>
)
})}
</div>
)
})}
{/* Campeón */}
<div className="flex flex-col justify-center gap-4 w-40 flex-shrink-0 relative">
<div className="absolute -top-4 left-0 text-[10px] font-bold text-pickleYellow uppercase">CAMPEÓN</div>
{(() => {
const finalMatch = tournamentData.matches.find(m => m.round === tournamentData.totalRounds);
if (finalMatch && finalMatch.status === 'completed') {
const champ = getTeam(finalMatch.winnerId);
return (
<div className="bg-pickleYellow/10 border border-pickleYellow rounded-lg p-4 flex flex-col items-center text-center">
{renderAvatar(champ, "w-10 h-10 text-lg mb-2")}
<span className="font-bold text-white text-sm">{champ.name}</span>
</div>
)
}
return (
<div className="bg-[#0A0E1A] border border-dashed border-gray-800 rounded-lg p-4 flex flex-col items-center text-center opacity-50">
<span className="font-semibold text-gray-500 text-xs">Por Definir</span>
</div>
)
})()}
</div>
</div>
</div>
)}
{/* ==========================================
Pestaña: Partidos
========================================== */}
{activeTab === 'matches' && tournamentData && (
<div className="space-y-4">
<div className="grid md:grid-cols-2 gap-4">
{tournamentData.matches.filter(m => m.teamAId && m.teamBId && m.status !== 'pending').map(m => {
const tA = getTeam(m.teamAId), tB = getTeam(m.teamBId);
const isDone = m.status === 'completed';
return (
<div key={m.id} className={⁠bg-pickleCard border p-4 rounded-xl flex flex-col gap-4 ${m.status === 'live' ? 'border-pickleGreen' : 'border-gray-800'}⁠}>
<div className="flex justify-between items-center text-[10px] font-semibold text-gray-500 uppercase border-b border-gray-800 pb-2">
<span>Partido {m.id}</span>
<span className={isDone ? 'text-gray-500' : 'text-pickleGreen'}>{isDone ? 'Finalizado' : 'Activo'}</span>
</div>
<div className="flex justify-between items-center gap-2">
<div className="flex-1 text-center flex flex-col items-center">
<div className="mb-1">{renderAvatar(tA, "w-10 h-10 text-lg")}</div>
<div className="text-xs font-bold text-white truncate w-full px-1">{tA.name}</div>
{localIsAdmin && !isDone && (
<div className="flex justify-center gap-1 mt-2">
<button onClick={()=>updateScore(m.id, 'A', false)} className="w-8 h-8 bg-gray-800 text-white rounded font-bold">-</button>
<button onClick={()=>updateScore(m.id, 'A', true)} className="w-8 h-8 bg-gray-700 text-white rounded font-bold">+</button>
</div>
)}
</div>
<div className="bg-black/40 px-2 py-2 rounded-lg flex items-center gap-1 font-mono font-bold text-xl border border-gray-800">
<input type="number" min="0" disabled={!localIsAdmin || isDone} value={m.scoreA} onChange={(e) => updateScore(m.id, 'A', e.target.value)} className={⁠w-8 h-8 bg-transparent text-center focus:outline-none ${!localIsAdmin ? 'select-none' : ''} ${m.winnerId === tA.id ? 'text-white' : 'text-gray-400'}⁠} />
<span className="text-gray-600 text-sm">:</span>
<input type="number" min="0" disabled={!localIsAdmin || isDone} value={m.scoreB} onChange={(e) => updateScore(m.id, 'B', e.target.value)} className={⁠w-8 h-8 bg-transparent text-center focus:outline-none ${!localIsAdmin ? 'select-none' : ''} ${m.winnerId === tB.id ? 'text-white' : 'text-gray-400'}⁠} />
</div>
<div className="flex-1 text-center flex flex-col items-center">
<div className="mb-1">{renderAvatar(tB, "w-10 h-10 text-lg")}</div>
<div className="text-xs font-bold text-white truncate w-full px-1">{tB.name}</div>
{localIsAdmin && !isDone && (
<div className="flex justify-center gap-1 mt-2">
<button onClick={()=>updateScore(m.id, 'B', true)} className="w-8 h-8 bg-gray-700 text-white rounded font-bold">+</button>
<button onClick={()=>updateScore(m.id, 'B', false)} className="w-8 h-8 bg-gray-800 text-white rounded font-bold">-</button>
</div>
)}
</div>
</div>
{localIsAdmin && !isDone && (m.scoreA >= tournamentData.pointsToWin || m.scoreB >= tournamentData.pointsToWin) && (
<button onClick={()=>finishMatch(m.id)} className="w-full bg-gray-100 text-black font-bold py-2.5 rounded-lg text-[10px] uppercase mt-2 hover:bg-white transition-colors">
Guardar
</button>
)}
</div>
);
})}
</div>
</div>
)}
{/* ==========================================
Pestaña: Equipos
========================================== */}
{activeTab === 'teams' && tournamentData && (
<div className="grid grid-cols-2 gap-3">
{tournamentData.teams.map(t => (
<div key={t.id} className="bg-pickleCard border border-gray-800 rounded-xl p-3 flex justify-between items-center">
<div className="flex items-center gap-2 w-full overflow-hidden">
{renderAvatar(t, "w-6 h-6 text-xs")}
<span className="font-semibold text-white text-xs truncate">{t.name}</span>
</div>
{localIsAdmin && (
<button onClick={()=>removeTeam(t.id)} className="text-gray-500 hover:text-red-400 font-bold px-2 py-1 rounded text-xs ml-2 transition-colors">X</button>
)}
</div>
))}
</div>
)}
</div>
)}
</main>
</div>
);
}
const root = ReactDOM.createRoot(document.getElementById('root'));
root.render(<App />);
</script>
</body>
</html>
